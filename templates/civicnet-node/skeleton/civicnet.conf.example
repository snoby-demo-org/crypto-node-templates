# civicnet.conf — CivicNet node
# Set rpcuser/rpcpassword at deploy time; keep the password secret.
rpcuser=${{ values.rpcUser }}
rpcpassword=CHANGE_ME
rpcport=${{ values.rpcPort }}
rpcallowip=127.0.0.1
rpcbind=0.0.0.0

# P2P
port=${{ values.p2pPort }}
listen=1
server=1
daemon=0

# ZMQ (used by the mining pool feed) — the container entrypoint also passes
# -zmqpub* flags; these lines pin the providers.
zmqpubhashblock=tcp://0.0.0.0:28332
zmqpubhashtx=tcp://0.0.0.0:28333
zmqpubrawblock=tcp://0.0.0.0:28334
zmqpubrawtx=tcp://0.0.0.0:28335

# Seed / addnode as needed:
# addnode=<seed>:<p2pPort>
